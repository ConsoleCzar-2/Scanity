# Scanity Frontend Environment Configuration

# Application Details
NEXT_PUBLIC_APP_NAME=Scanity
NEXT_PUBLIC_APP_VERSION=v1.0

# Base URL for the FastAPI v1 endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Root URL for the FastAPI backend (health probes)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Model & Architecture Badges
NEXT_PUBLIC_LLM_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_LLM_MODEL_DISPLAY=Gemini 3.5 Flash Lite
NEXT_PUBLIC_EMBEDDING_MODEL=gemini-embedding-001
NEXT_PUBLIC_VECTOR_DIMENSION=768

# Ingestion & Upload Parameters
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
NEXT_PUBLIC_CHUNK_SIZE_TOKENS=700
NEXT_PUBLIC_CHUNK_OVERLAP_TOKENS=100
NEXT_PUBLIC_POLL_INTERVAL_MS=2000

# Retrieval & Guardrails
NEXT_PUBLIC_RELEVANCE_THRESHOLD=0.70
NEXT_PUBLIC_DEFAULT_TOP_K=5
