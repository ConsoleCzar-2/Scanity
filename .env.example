# Application
APP_NAME=Scanity
APP_ENV=development
DEBUG=true

# CORS
CORS_ORIGINS=["https://<website>vercel.app", "http://localhost:3000"]
CORS_ORIGINS_REGEX=^https://.*.vercel.app$

# Database Configuration (Docker Compose variables)
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@localhost:5432/scanity

# pgAdmin Configuration
PGADMIN_EMAIL=your_pgadmin_email_here
PGADMIN_PASSWORD=your_pgadmin_password_here

# LLM API Keys (replace with real keys)
GEMINI_API_KEY=your_gemini_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (for caching/sessions/celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
