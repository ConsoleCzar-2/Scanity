# Application
APP_NAME=Scanity
APP_ENV=development
DEBUG=true

# CORS
CORS_ORIGINS=["https://<website>vercel.app", "http://localhost:3000"]
CORS_ORIGINS_REGEX=^https://.*.vercel.app$

# Frontend Env Config
NEXT_PUBLIC_APP_NAME=Scanity
NEXT_PUBLIC_APP_VERSION=v1.0
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

NEXT_PUBLIC_LLM_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_LLM_MODEL_DISPLAY=Gemini 3.5 Flash Lite
NEXT_PUBLIC_EMBEDDING_MODEL=gemini-embedding-001
NEXT_PUBLIC_VECTOR_DIMENSION=768
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
NEXT_PUBLIC_CHUNK_SIZE_TOKENS=700
NEXT_PUBLIC_CHUNK_OVERLAP_TOKENS=100
NEXT_PUBLIC_POLL_INTERVAL_MS=2000
NEXT_PUBLIC_RELEVANCE_THRESHOLD=0.70
NEXT_PUBLIC_DEFAULT_TOP_K=5

# Backend Env Config
# Database Configuration (Docker Compose variables)
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@localhost:5433/scanity

# pgAdmin Configuration
PGADMIN_EMAIL=your_pgadmin_email_here
PGADMIN_PASSWORD=your_pgadmin_password_here

# LLM API Keys & Embeddings (replace with real keys)
GEMINI_API_KEY=your_gemini_api_key_here

VECTOR_DIMENSION=768
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-3.5-flash-lite
MULTIMODAL_EMBEDDING_MODEL=gemini-embedding-002

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (for caching/sessions/celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Retrieval & Anti-Hallucination Guardrails
RELEVANCE_THRESHOLD=0.70
DEFAULT_TOP_K=5
